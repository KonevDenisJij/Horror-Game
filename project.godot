;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HorrorGame2"
run/main_scene="uid://cuednh4yuj6gs"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

NpcsHolder="*res://Scenes/NPC/NpcsHolder.tscn"
PointsHolder="*res://Scenes/Points/PointsHolder.tscn"
MouseModeController="*res://Scenes/DifferentSystems/MouseModeController.tscn"
PauseMenu="*res://Scenes/Menu/PauseMenu.tscn"
DialogueSystem="*res://Scenes/DialogueSystem/DialogueSystem.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="HorrorGame2"

[editor]

movie_writer/fps=144

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="uid://bordlib3tkn4j"

