code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_11;
uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_14 : source_color;
uniform sampler2D tex_frg_13;



void fragment() {
// Input:5
	vec2 n_out5p0 = UV;


// FloatConstant:16
	float n_out16p0 = 1.500000;


// UVFunc:15
	vec2 n_in15p2 = vec2(0.00000, 0.00000);
	vec2 n_out15p0 = (n_out5p0 - n_in15p2) * vec2(n_out16p0) + n_in15p2;


// Vector2Constant:9
	vec2 n_out9p0 = vec2(0.500000, 0.500000);


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, UV);


	float n_out12p0;
// Remap:12
	float n_in12p1 = 0.00000;
	float n_in12p2 = 1.00000;
	float n_in12p3 = 0.00000;
	float n_in12p4 = 360.00000;
	{
		float __input_range = n_in12p2 - n_in12p1;
		float __output_range = n_in12p4 - n_in12p3;
		n_out12p0 = n_in12p3 + __output_range * ((n_out11p0.x - n_in12p1) / __input_range);
	}


	vec2 n_out10p0;
// Expression:10
	n_out10p0 = vec2(0.0, 0.0);
	{
		n_out15p0 -= n_out9p0;
		float rotation_radius = radians(n_out12p0);
		float c = cos(rotation_radius);
		float s = sin(rotation_radius);
		
		n_out10p0.x = n_out15p0.x * c + n_out15p0.y * s;
		n_out10p0.y = n_out15p0.y * c - n_out15p0.x * s;
		
		n_out10p0 += n_out9p0;
	}


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out10p0);


// Texture2D:14
	vec4 n_out14p0 = texture(tex_frg_14, n_out15p0);


// Texture2D:13
	vec4 n_out13p0 = texture(tex_frg_13, UV);


// Mix:17
	vec2 n_out17p0 = mix(vec2(n_out2p0.xy), vec2(n_out14p0.xy), vec2(n_out13p0.xy));


// Output:0
	ALBEDO = vec3(n_out17p0, 0.0);


}
